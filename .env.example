# Champion English School - Complete Environment Configuration
# Copy this file to .env.local and update with your actual values

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ============================================
# APPLICATION SETTINGS
# ============================================
NEXT_PUBLIC_APP_URL=https://champion-school.example.com
NODE_ENV=production

# ============================================
# FIREBASE CLOUD MESSAGING (Optional - for push notifications)
# ============================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ============================================
# FILE STORAGE
# ============================================
# For Supabase Storage:
NEXT_PUBLIC_STORAGE_BUCKET=champion-school-files

# For AWS S3 (alternative):
# STORAGE_ACCESS_KEY=YOUR_AWS_ACCESS_KEY
# STORAGE_SECRET_KEY=YOUR_AWS_SECRET_KEY
# STORAGE_REGION=ap-south-1
# STORAGE_BUCKET=champion-school-files

# ============================================
# SECURITY
# ============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
RATE_LIMIT_ENABLED=true

# ============================================
# DATABASE (Only if using local PostgreSQL instead of Supabase)
# ============================================
DB_PASSWORD=champion_school_secure_password
DB_PORT=5432

# ============================================
# REDIS (Optional - for enhanced rate limiting and caching)
# ============================================
REDIS_PORT=6379

# ============================================
# APPLICATION PORT
# ============================================
APP_PORT=3000

# ============================================
# NGINX/SSL (Production only)
# ============================================
# SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
# SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=info

# ============================================
# BACKUP CONFIGURATION (Optional)
# ============================================
# BACKUP_S3_BUCKET=champion-school-backups
# BACKUP_SCHEDULE=0 2 * * *
